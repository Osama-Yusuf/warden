# warden environment. Copy to .env (gitignored), loaded by every app
# (cli/web/desktop) from the repo root, cwd, or ~/.warden.env.

# Admin credentials (CLI uses both; web UI prefills the username only,
# the password stays out of the browser until you type it)
#WARDEN_ADMIN_USER=admin
#WARDEN_ADMIN_PASS=

# Default environment to select
#WARDEN_ENV=production

# Web server bind address
#WARDEN_WEB_HOST=127.0.0.1
#WARDEN_WEB_PORT=8642

# Extra/override environments as JSON (same shape as the built-ins);
# environments.local.json in the repo root is picked up automatically.
#WARDEN_ENVIRONMENTS_FILE=./environments.local.json

# Audit log location (default: ~/.warden/audit.log)
#WARDEN_AUDIT_LOG=
